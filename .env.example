# Owner setup. Copy to .env; this file is never served or committed.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DATA_WORKER_NAME=data-accounts
APP_ORIGIN=https://data-accounts.YOUR-SUBDOMAIN.workers.dev
EMAIL_FROM=login@YOUR-VERIFIED-DOMAIN
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Ranking starts disabled until a bounded deployed usage benchmark passes.
RANKED_ENABLED=false
# Optional limits; initial defaults reserve 1 GiB per run and 100 GiB per month.
MAX_RUN_BYTES=1073741824
MAX_RUN_SECONDS=600
MONTHLY_BYTE_BUDGET=107374182400
DAILY_USER_BYTE_BUDGET=10737418240
DAILY_EMAIL_BUDGET=100
UPSTREAM_CONCURRENCY=2
